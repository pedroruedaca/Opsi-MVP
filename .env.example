# Postgres. Local: `docker compose up -d`. Production: Neon pooled connection string.
DATABASE_URL=postgres://opsi:opsi@localhost:5432/opsi

# Shared demo password and the secret used to sign the session cookie (at least 32 characters).
DEMO_PASSWORD=change-me
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars

# Vercel Blob (private store). When unset, uploads are stored on local disk under .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Anthropic (Phase 2).
ANTHROPIC_API_KEY=
